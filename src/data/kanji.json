ices": ["設属", "接属", "設族", "接続"], "meaning": "kết nối", "level": "N2" }, { "id": "k043", "sentence": "私は親に[さからって]大学に進学した。", "word": "逆らって", "reading": "さからって", "answer": "逆らって", "choices": ["逆らって", "敵らって", "拒って", "争って"], "meaning": "chống đối, ngược lại", "level": "N2" }, { "id": "k044", "sentence": "田中社長の強引なやり方を[ひはん]する人もいる。", "word": "批判", "reading": "ひはん", "answer": "批判", "choices": ["非判", "批判", "批反", "非反"], "meaning": "phê bình, chỉ trích", "level": "N2" }, { "id": "k045", "sentence": "A社の製品のほうが機能の面で[おとっている]と思う。", "word": "劣っている", "reading": "おとっている", "answer": "劣っている", "choices": ["悪っている", "負っている", "劣っている", "乏っている"], "meaning": "kém hơn, yếu hơn", "level": "N2" }, { "id": "k046", "sentence": "[くわしい]ことは、あとで担当の先生に聞いてください。", "word": "詳しい", "reading": "くわしい", "answer": "詳しい", "choices": ["許しい", "詳しい", "討しい", "評しい"], "meaning": "chi tiết, tường tận", "level": "N2" }, { "id": "k047", "sentence": "兄は学費の[えんじょ]を受けて大学に通いました。", "word": "援助", "reading": "えんじょ", "answer": "援助", "choices": ["補助", "援財", "補財", "援助"], "meaning": "viện trợ, hỗ trợ", "level": "N2" }, { "id": "k048", "sentence": "物を入れすぎて袋が[やぶれて]しまった。", "word": "破れて", "reading": "やぶれて", "answer": "破れて", "choices": ["被れて", "割れて", "破れて", "削れて"], "meaning": "rách, bị rách", "level": "N2" }, { "id": "k049", "sentence": "これは少し[めんどう]な仕事ですね。", "word": "面倒", "reading": "めんどう", "answer": "面倒", "choices": ["面到", "免倒", "面倒", "免到"], "meaning": "phiền phức, rắc rối", "level": "N2" }, { "id": "k050", "sentence": "家に帰る途中、手帳を[ひろった]。", "word": "拾った", "reading": "ひろった", "answer": "拾った", "choices": ["拾った", "採った", "捨った", "授った"], "meaning": "nhặt được", "level": "N2" } ]